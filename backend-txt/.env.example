# A2UI 餐厅助手 —— 后端环境变量
# 复制为 backend/.env 并填入真实值，然后启动：python backend/server.py
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库。

# ----- LLM 配置 -----
# 本地 Ollama（默认）
LLM_MODEL=ollama_chat/qwen3.8:27b-mlx
LLM_API_BASE=http://localhost:11434

# 通义千问（DashScope）—— 取消注释并填入 key 即可切换
# LLM_MODEL=dashscope/qwen-max
# LLM_API_KEY=sk-your-dashscope-api-key-here

# OpenAI / DeepSeek 等 LiteLLM 支持的 provider 同理
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=sk-your-deepseek-api-key-here
# LLM_API_BASE=https://api.deepseek.com  # 仅自定义端点时需要

# ----- 服务 -----
HOST=127.0.0.1
PORT=8000
